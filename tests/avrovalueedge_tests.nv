// avrovalueedge_tests.nv — what a value is checked against, both JSON
// forms at their edges, the sort order, and every fault the binary
// decoder answers.

use std.test
use std.bytes
use avrobinary
use avroerror
use avroschema
use avrovalue

// A schema from its JSON text, or a fault the test reports.
fn schema(text: Str) -> AvroSchema
    match avroschema.parse(text)
        Ok(s)  => s
        Err(_) => avroschema.primitive(AvroNull)

// A value from Avro's JSON encoding, or null when it does not parse.
fn value(text: Str, s: AvroSchema) -> AvroValue
    match avrovalue.from_json(text, s)
        Ok(v)  => v
        Err(_) => AvroNullValue

// A schema, a value that does not fit it, and the path the fault names.
fn misfits() -> [(Str, AvroValue, Str)]
    [("\"int\"", AvroIntValue(2147483648), ""),
     ("\"int\"", AvroLongValue(1), ""),
     ("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\"]}", AvroEnumValue(1), "E"),
     ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":2}", AvroFixedValue(bytes.zeros(3)), "F"),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"}]}",
        AvroRecordValue([]),
        "R"),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"}]}",
      AvroRecordValue([AvroStrValue("x")]), "R.a"),
     ("{\"type\":\"array\",\"items\":\"int\"}",
        AvroArrayValue([AvroIntValue(1), AvroNullValue]),
        "[1]"),
     ("{\"type\":\"map\",\"values\":\"int\"}", AvroMapValue(["a"], []), ""),
     ("{\"type\":\"map\",\"values\":\"int\"}", AvroMapValue(["a"], [AvroNullValue]), "[a]"),
     ("[\"null\",\"int\"]", AvroUnionValue(2, [AvroNullValue]), ""),
     ("[\"null\",\"int\"]", AvroUnionValue(1, [AvroNullValue]), "")]

@test
fn test_a_value_that_does_not_fit_is_refused_at_its_path() [io]
    for (text, v, path) in misfits()
        test.case("${text} ${path}")
        match avrovalue.check(v, schema(text))
            Ok(_)  => test.fail("the value does not fit")
            Err(f) =>
                test.assert_eq_str(avroerror.kind_name(f.kind), "bad-schema-shape")
                test.assert_eq_str(f.at.path, path)
    test.case("a value that fits counts every value in it")
    let s = schema("{\"type\":\"map\",\"values\":[\"null\",{\"type\":\"array\",\"items\":\"long\"}]}")
    let v = AvroMapValue(["a"], [AvroUnionValue(1, [AvroArrayValue([AvroLongValue(1), AvroLongValue(2)])])])
    match avrovalue.check(v, s)
        Ok(n)  => test.assert(n == 5)
        Err(e) => test.fail(e.message())

@test
fn test_a_reference_without_its_definition_is_an_unknown_type() [io]
    let s = schema("{\"type\":\"record\",\"name\":\"L\",\"fields\":[{\"name\":\"next\",\"type\":[\"null\",\"L\"]}]}")
    let alone = s.fields[0].schema
    match avrovalue.check(AvroUnionValue(1, [AvroRecordValue([])]), alone)
        Ok(_)  => test.fail("L is not defined inside the union")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "unknown-type")
    match avrobinary.decode(bytes.from_byte_list([2, 0]), 0, alone, avrobinary.default_limits())
        Ok(_)  => test.fail("L is not defined inside the union")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "unknown-type")

// A schema and JSON the JSON decoder refuses.
fn bad_json() -> [(Str, Str)]
    [("\"null\"", "1"), ("\"boolean\"", "1"), ("\"int\"", "1.5"), ("\"long\"", "\"1\""),
     ("\"float\"", "\"x\""), ("\"double\"", "true"), ("\"string\"", "1"), ("\"bytes\"", "\"\\u0100\""),
     ("\"bytes\"", "1"), ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":2}", "\"a\""),
     ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":2}", "1"),
     ("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\"]}", "\"B\""),
     ("{\"type\":\"array\",\"items\":\"int\"}", "{}"), ("{\"type\":\"map\",\"values\":\"int\"}", "[]"),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"}]}", "[]"),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"}]}", "{}"),
     ("[\"int\",\"string\"]", "null"), ("[\"null\",\"int\"]", "{\"int\":1,\"long\":2}"),
     ("[\"null\",\"int\"]", "5"), ("[\"null\",\"int\"]", "{\"long\":2}"), ("\"int\"", "{")]

@test
fn test_json_that_does_not_fit_the_schema_is_refused() [io]
    for (text, j) in bad_json()
        test.case("${j} under ${text}")
        match avrovalue.from_json(j, schema(text))
            Ok(_)  => test.fail("the JSON does not fit")
            Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "bad-schema-shape")
    test.case("a default that does not fit is a bad default")
    match avrovalue.from_default_json("\"x\"", schema("\"int\""))
        Ok(_)  => test.fail("a string is not an int")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "bad-default")
    test.case("an empty union has no default")
    match avrovalue.from_default_json("null", schema("[]"))
        Ok(_)  => test.fail("an empty union has no branch to default to")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "bad-default")

@test
fn test_the_json_forms_at_their_edges() [io]
    test.case("a float that is not a number is written as a string and read back")
    let d = schema("\"double\"")
    for x in [0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0]
        match avrovalue.to_json(AvroDoubleValue(x), d)
            Err(e) => test.fail(e.message())
            Ok(j)  =>
                test.assert(str.starts_with(j, "\""))
                match avrovalue.from_json(j, d)
                    Ok(AvroDoubleValue(y)) => test.assert(x != x and y != y or x == y)
                    _                      => test.fail("it reads back")
    test.case("a missing field takes its default, a union default its first branch")
    let r = schema("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":[\"long\",\"null\"],\"default\":3}]}")
    match avrovalue.from_json("{}", r)
        Err(e) => test.fail(e.message())
        Ok(v)  =>
            match avrovalue.to_json(v, r)
                Ok(j)  => test.assert_eq_str(j, "{\"a\":{\"long\":3}}")
                Err(e) => test.fail(e.message())
            match avrovalue.field_of(v, r, "a")
                Some(a) => test.assert_eq_str(avrovalue.kind_name(a), "union")
                None    => test.fail("R has a field a")
            test.assert_none(avrovalue.field_of(v, r, "b"))
    test.case("a map is read by key")
    let m = value("{\"x\":1,\"y\":2}", schema("{\"type\":\"map\",\"values\":\"int\"}"))
    match avrovalue.map_get(m, "y")
        Some(AvroIntValue(n)) => test.assert(n == 2)
        _                     => test.fail("the map has y")
    test.assert_none(avrovalue.map_get(m, "z"))
    test.case("a value that does not fit has no JSON")
    match avrovalue.to_json(AvroIntValue(1), schema("\"string\""))
        Ok(_)  => test.fail("an int is not a string")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "bad-schema-shape")

// A schema, two values in JSON, and the sign `compare` answers.
fn orders() -> [(Str, Str, Str, Int)]
    [("\"null\"", "null", "null", 0),
     ("\"boolean\"", "false", "true", -1), ("\"boolean\"", "true", "false", 1),
     ("\"int\"", "3", "2", 1), ("\"float\"", "1.5", "2.5", -1), ("\"double\"", "2.5", "2.5", 0),
     ("\"bytes\"", "\"ab\"", "\"a\"", 1), ("\"bytes\"", "\"a\"", "\"b\"", -1),
     ("\"string\"", "\"\\u00e9\"", "\"z\"", 1), ("\"string\"", "\"a\"", "\"ab\"", -1),
     ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":1}", "\"a\"", "\"a\"", 0),
     ("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"Z\",\"A\"]}", "\"Z\"", "\"A\"", -1),
     ("{\"type\":\"array\",\"items\":\"int\"}", "[1,2]", "[1,3]", -1),
     ("{\"type\":\"array\",\"items\":\"int\"}", "[1,2]", "[1]", 1),
     ("[\"null\",\"int\"]", "null", "{\"int\":1}", -1),
     ("[\"null\",\"int\"]", "{\"int\":2}", "{\"int\":1}", 1),
     ("{\"type\":\"map\",\"values\":\"int\"}", "{\"a\":1}", "{\"b\":2}", 0),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\",\"order\":\"ignore\"},{\"name\":\"b\",\"type\":\"int\",\"order\":\"descending\"},{\"name\":\"c\",\"type\":\"int\"}]}",
      "{\"a\":1,\"b\":1,\"c\":1}", "{\"a\":2,\"b\":2,\"c\":0}", 1),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\",\"order\":\"ignore\"},{\"name\":\"c\",\"type\":\"int\"}]}",
      "{\"a\":1,\"c\":1}", "{\"a\":2,\"c\":2}", -1),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\",\"order\":\"ignore\"}]}",
      "{\"a\":1}", "{\"a\":2}", 0)]

@test
fn test_the_sort_order_is_the_specifications() [io]
    for (text, a, b, want) in orders()
        test.case("${a} against ${b} under ${text}")
        let s = schema(text)
        test.assert(avrovalue.compare(value(a, s), value(b, s), s) == want)
    test.case("the constructors")
    test.assert_eq_str(avrovalue.kind_name(AvroBoolValue(true)), "boolean")
    test.assert_eq_str(avrovalue.kind_name(AvroFloatValue(1.0)), "float")
    test.assert_eq_str(avrovalue.kind_name(AvroDoubleValue(1.0)), "double")
    test.assert_eq_str(avrovalue.kind_name(AvroRecordValue([])), "record")
    test.assert_eq_str(avrovalue.kind_name(AvroArrayValue([])), "array")
    test.assert_eq_str(avrovalue.kind_name(AvroMapValue([], [])), "map")
    test.assert_eq_str(avrovalue.kind_name(AvroFixedValue(bytes.zeros(1))), "fixed")

// A schema, input in hexadecimal, and the fault kind a decode answers.
fn damaged() -> [(Str, Str, Str)]
    [("\"boolean\"", "", "truncated"), ("\"int\"", "", "truncated"),
     ("\"int\"", "8080808080808080808001", "bad-varint"), ("\"int\"", "80808080808080808002", "bad-varint"),
     ("\"int\"", "8080808010", "bad-varint"), ("\"float\"", "000000", "truncated"),
     ("\"double\"", "00000000000000", "truncated"), ("\"bytes\"", "01", "negative-length"),
     ("\"bytes\"", "0400", "truncated"), ("\"string\"", "80", "truncated"),
     ("\"bytes\"", "80808080808080808002", "bad-varint"),
     ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":2}", "00", "truncated"),
     ("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\"]}", "02", "bad-enum-index"),
     ("{\"type\":\"enum\",\"name\":\"E\",\"symbols\":[\"A\"]}", "80", "truncated"),
     ("[\"null\",\"int\"]", "04", "bad-union-index"), ("[\"null\",\"int\"]", "", "truncated"),
     ("[\"null\",\"int\"]", "02", "truncated"),
     ("{\"type\":\"record\",\"name\":\"R\",\"fields\":[{\"name\":\"a\",\"type\":\"int\"}]}",
        "",
        "truncated"),
     ("{\"type\":\"array\",\"items\":\"int\"}", "", "truncated"),
     ("{\"type\":\"array\",\"items\":\"int\"}", "0103", "negative-length"),
     ("{\"type\":\"array\",\"items\":\"int\"}", "0280", "truncated"),
     ("{\"type\":\"map\",\"values\":\"int\"}", "0103", "negative-length"),
     ("{\"type\":\"map\",\"values\":\"int\"}", "020261", "truncated")]

@test
fn test_every_damaged_input_is_refused_with_its_own_kind() [io]
    for (text, hex, kind) in damaged()
        test.case("${hex} under ${text}")
        let s = schema(text)
        let src = bytes.from_hex(hex) ?? bytes.zeros(0)
        match avrobinary.decode(src, 0, s, avrobinary.default_limits())
            Ok(_)  => test.fail("the input is damaged")
            Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), kind)
        let c = avrobinary.skip(src, avrobinary.cursor(0), s, avrobinary.default_limits())
        test.assert(not c.ok)
        match avrobinary.fault_of(c, 0)
            None    => test.fail("a failed cursor has a fault")
            Some(f) =>
                if kind == "bad-enum-index"
                    test.assert_eq_str(avroerror.kind_name(f.kind), "bad-union-index")
                else
                    test.assert_eq_str(avroerror.kind_name(f.kind), kind)

@test
fn test_the_limits_are_held_and_can_be_lifted() [io]
    let tight = AvroLimits { max_length: 2, max_items: 1, max_depth: 1 }
    for (text, hex) in [("\"bytes\"", "06616263"), ("{\"type\":\"fixed\",\"name\":\"F\",\"size\":3}", "616263"),
                        ("{\"type\":\"array\",\"items\":\"int\"}", "04020400"),
                        ("{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":\"int\"}}", "0202020000")]
        test.case(text)
        let s = schema(text)
        let src = bytes.from_hex(hex) ?? bytes.zeros(0)
        match avrobinary.decode(src, 0, s, tight)
            Ok(_)  => test.fail("the input is over a limit")
            Err(f) => test.assert(avroerror.is_limit(f.kind))
        match avrobinary.decode(src, 0, s, avrobinary.no_limits())
            Ok(_)  => test.assert(true)
            Err(e) => test.fail(e.message())
        let c = avrobinary.skip(src, avrobinary.cursor(0), s, tight)
        test.assert(c.fault == avrobinary.AVRO_CURSOR_LIMIT)
        match avrobinary.fault_of(c, 2)
            Some(f) => test.assert(avroerror.is_limit(f.kind) and f.at.block == 2)
            None    => test.fail("a failed cursor has a fault")

@test
fn test_a_float_keeps_its_32_bits_through_every_special_value() [io]
    let s = schema("\"float\"")
    for x in [0.0, -0.0, 1.5, 0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0, 1.0e-40, -1.0e-40, 1.0e-50]
        test.case("${x}")
        match avrobinary.encode(AvroFloatValue(x), s)
            Err(e) => test.fail(e.message())
            Ok(b)  =>
                test.assert(bytes.len(b) == 4)
                match avrobinary.decode(b, 0, s, avrobinary.default_limits())
                    Ok(AvroFloatValue(y)) =>
                        let wide: fp32 = x
                        let back: Float = wide
                        test.assert(back != back and y != y or float.to_bits(back) == float.to_bits(y))
                    _                     => test.fail("four bytes are a float")

@test
fn test_the_low_level_reads_and_writes_at_their_edges() [io]
    test.case("a failed cursor is answered unchanged")
    let bad = avrobinary.read_long(bytes.zeros(0), avrobinary.cursor(0)).cursor
    test.assert(avrobinary.read_long(bytes.zeros(4), bad).cursor.at == bad.at)
    test.assert(avrobinary.skip(bytes.zeros(4), bad, schema("\"int\""), avrobinary.default_limits()).at == bad.at)
    test.case("a negative block count declares a byte size")
    let h = avrobinary.read_block_header(bytes.from_byte_list([3, 8]), avrobinary.cursor(0))
    test.assert(h.count == 2 and h.byte_size == 4 and h.cursor.at == 2)
    test.case("an offset outside the buffer has no room")
    match avrobinary.write_long(1, bytes.zeros(4), -1)
        Ok(_)  => test.fail("-1 is not an offset")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "buffer-too-small")
    match avrobinary.encode_into(AvroIntValue(300), schema("\"int\""), bytes.zeros(1), 0)
        Ok(_)  => test.fail("300 takes two bytes")
        Err(f) => test.assert_eq_str(avroerror.kind_name(f.kind), "buffer-too-small")
    match avrobinary.encoded_bytes(AvroIntValue(1), schema("\"string\""))
        Ok(_)  => test.fail("an int is not a string")
        Err(f) => test.assert(avroerror.is_schema_error(f.kind))
    test.case("the largest and smallest long take ten bytes")
    test.assert(avrobinary.long_bytes(9223372036854775807) == 10)
    test.assert(avrobinary.long_bytes(-9223372036854775807 - 1) == 10)
