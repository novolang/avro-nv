// avrocodec.nv — the compression codecs a container file may use, as
// values a caller hands in rather than as dependencies.
//
// The Avro specification names the codecs `null`, `deflate` and
// `snappy`, and says an implementation may add others; `zstandard`,
// `bzip2` and `xz` are in use.  `avro.codec` is a string in a file's
// metadata, so the set is open.
//
// A codec here is a value: a name and named functions.  A caller wires
// in flate-nv, its own implementation or nothing, and only `null` is
// built in, because it is not compression.  The alternatives were
// weighed and refused.  Implementing the codecs here would put four
// compression formats inside a serialisation package.  Depending on
// flate-nv, snappy-nv and zstd-nv would put them in every consumer's
// build, because a manifest has no optional dependencies, and all
// three are interface releases today.  A closed enum of names would
// refuse a file a newer writer produced.
//
// The functions are named functions and not closures, because a lambda
// held as a value is refused on a microcontroller, and because
// parquet-nv's `PqDecompressor` has the same shape, so a program
// reading Parquet and Avro wires one pair of functions to both.
//
// An unknown codec does not make a file corrupt.  `AvroUnsupportedCodec`
// carries the name, `avroerror.is_unsupported` answers true for it, and
// `avrofile.readable_with` asks the question over a file's header, so
// the refusal comes when the file is opened.

use std.bytes
use avroerror

// The codec name for no compression: `"null"`.
//
// The specification requires it, and a writer told nothing uses it.
pub const AVRO_CODEC_NULL = "null"

// The codec name for raw DEFLATE: `"deflate"`.
//
// RFC 1951, with no zlib wrapper and no gzip header.
pub const AVRO_CODEC_DEFLATE = "deflate"

// The codec name for Snappy: `"snappy"`.
//
// A Snappy block, followed by a four-byte big-endian CRC-32C of the
// uncompressed data, which the Snappy format itself does not have.
// `decompress` and `compress` check and add it.
pub const AVRO_CODEC_SNAPPY = "snappy"

// The codec name for Zstandard: `"zstandard"`.
//
// Spelled in full, not `"zstd"`.  A file written with the short
// spelling is reported as unsupported.
pub const AVRO_CODEC_ZSTANDARD = "zstandard"

// The codec name for bzip2: `"bzip2"`.
pub const AVRO_CODEC_BZIP2 = "bzip2"

// The codec name for xz: `"xz"`.
pub const AVRO_CODEC_XZ = "xz"

// The bytes Avro's Snappy framing adds after a compressed block: 4.
//
// A big-endian CRC-32C of the uncompressed data.
pub const AVRO_SNAPPY_TRAILER_BYTES = 4

// A codec a caller supplies, as a name and three named functions.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     println(avrocodec.name_of(avrocodec.null_codec()))
// ```
pub struct AvroCodec
    // The name as it appears in a file's `avro.codec` metadata.
    name: Str
    // Answers the decompressed length of `len` bytes at `at`, or a
    // negative number when the payload is malformed.
    //
    // It is separate from `run` so that the size a file declares is
    // checked against a bound before anything is allocated.
    sized_by: fn(Bytes, Int, Int) -> Int
    // Decompresses `len` bytes at `at` into a new buffer.
    run: fn(Bytes, Int, Int) -> Bytes
    // Compresses `len` bytes at `at` into a new buffer, for a writer.
    // A codec supplied for reading only answers an empty buffer here,
    // and `writable` is then false.
    pack: fn(Bytes, Int, Int) -> Bytes
    // Whether `pack` is real.
    writable: Bool

// The size `null` data decompresses to: its own.
fn null_sized(src: Bytes, at: Int, len: Int) -> Int
    len

// `null` data, decompressed or compressed: a copy.
fn null_copy(src: Bytes, at: Int, len: Int) -> Bytes
    bytes.slice(src, at, at + len)

// The compressor of a codec supplied for reading only.
fn no_pack(src: Bytes, at: Int, len: Int) -> Bytes
    bytes.zeros(0)

// A parameter fault.
fn bad_parameter(what: Str) -> AvroFault
    avroerror.fault(AvroBadParameter(what), avroerror.at_path(""))

// The `null` codec: no compression.
//
// The block's bytes are the block's data.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     println(avrocodec.name_of(avrocodec.null_codec()))
// ```
pub fn null_codec() -> AvroCodec []
    AvroCodec { name: AVRO_CODEC_NULL, sized_by: null_sized, run: null_copy, pack: null_copy,
                writable: true }

// A read-only codec from a name and two named functions.
//
// `AvroBadParameter` for an empty name, and for `"null"`, which is
// built in and may not be replaced.
//
// ```novo
// use std.bytes
// use avrocodec
//
// fn sized(src: Bytes, at: Int, len: Int) -> Int
//     0
//
// fn run(src: Bytes, at: Int, len: Int) -> Bytes
//     bytes.zeros(0)
//
// fn main() [io]
//     match avrocodec.reader_codec("deflate", sized, run)
//         Ok(c)  => println(avrocodec.name_of(c))
//         Err(e) => println(e.message())
// ```
pub fn reader_codec(name: Str, sized_by: fn(Bytes, Int, Int) -> Int,
                    run: fn(Bytes, Int, Int) -> Bytes) -> Result<AvroCodec, AvroFault> []
    check_name(name)!
    Ok(AvroCodec { name: name, sized_by: sized_by, run: run, pack: no_pack, writable: false })

// Whether a caller may supply a codec of this name.
fn check_name(name: Str) -> Result<Int, AvroFault>
    if name == ""
        return Err(bad_parameter("a codec needs a name"))
    if name == AVRO_CODEC_NULL
        return Err(bad_parameter("`null` is built in and may not be replaced"))
    Ok(0)

// A codec that can also write.
//
// ```novo
// use std.bytes
// use avrocodec
//
// fn sized(src: Bytes, at: Int, len: Int) -> Int
//     0
//
// fn run(src: Bytes, at: Int, len: Int) -> Bytes
//     bytes.zeros(0)
//
// fn pack(src: Bytes, at: Int, len: Int) -> Bytes
//     bytes.zeros(0)
//
// fn main() [io]
//     match avrocodec.codec("deflate", sized, run, pack)
//         Ok(c)  => println("${avrocodec.can_write(c)}")
//         Err(e) => println(e.message())
// ```
pub fn codec(name: Str, sized_by: fn(Bytes, Int, Int) -> Int, run: fn(Bytes, Int, Int) -> Bytes,
             pack: fn(Bytes, Int, Int) -> Bytes) -> Result<AvroCodec, AvroFault> []
    check_name(name)!
    Ok(AvroCodec { name: name, sized_by: sized_by, run: run, pack: pack, writable: true })

// No caller-supplied codecs, only `null`.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     println("${list.len(avrocodec.only_null())}")
// ```
pub fn only_null() -> [AvroCodec] []
    [null_codec()]

// A codec's name.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     println(avrocodec.name_of(avrocodec.null_codec()))
// ```
pub fn name_of(c: AvroCodec) -> Str []
    c.name

// Whether a codec can compress as well as decompress.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     println("${avrocodec.can_write(avrocodec.null_codec())}")
// ```
pub fn can_write(c: AvroCodec) -> Bool []
    c.writable

// The codec of a given name among those supplied, or `None`.
//
// `"null"` always answers the built-in codec, whatever was supplied.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     match avrocodec.codec_named(avrocodec.only_null(), "deflate")
//         Some(_) => println("supplied")
//         None    => println("not supplied")
// ```
pub fn codec_named(supplied: [AvroCodec], name: Str) -> ?AvroCodec []
    if name == AVRO_CODEC_NULL
        return Some(null_codec())
    for c in supplied
        if c.name == name
            return Some(c)
    None

// Whether a named codec can be read with what the caller supplied.
//
// It is the question to ask over a file's header, before reading a
// block.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     let ok = avrocodec.can_read(avrocodec.only_null(), "snappy")
//     println("${ok}")
// ```
pub fn can_read(supplied: [AvroCodec], name: Str) -> Bool []
    codec_named(supplied, name) != None

// Whether a name is one of the six constants above.
//
// A name outside them is not refused, because `avro.codec` is an open
// set, but a writer probably meant one of these, and a `"zstd"` that
// should have been `"zstandard"` is worth catching before a file is
// written.
//
// ```novo
// use avrocodec
//
// fn main() [io]
//     let known = avrocodec.is_known_name("zstd")
//     println("${known}")
// ```
pub fn is_known_name(name: Str) -> Bool []
    list.contains([AVRO_CODEC_NULL, AVRO_CODEC_DEFLATE, AVRO_CODEC_SNAPPY, AVRO_CODEC_ZSTANDARD,
                   AVRO_CODEC_BZIP2, AVRO_CODEC_XZ],
                   name)

// The CRC-32C (Castagnoli) of `len` bytes at `at`, as RFC 3720
// section B.4 defines it.
fn crc32c(data: Bytes, at: Int, len: Int) -> Int
    var crc = 0xFFFFFFFF
    for i in at..at + len
        crc = crc ^ (bytes.byte_at(data, i) ?? 0)
        for _ in 0..8
            if (crc & 1) == 1
                crc = bits.shr(crc, 1) ^ 0x82F63B78
            else
                crc = bits.shr(crc, 1)
    crc ^ 0xFFFFFFFF

// Decompress a block's payload with a codec, bounded.
//
// It calls `sized_by` first, compares the answer with `limit`, and only
// then calls `run`.  `AvroLengthLimitReached` when the declared size is
// above the limit, where `-1` is no limit.  `AvroBadParameter` when
// `sized_by` answers a negative number, or `run` answers a different
// size than `sized_by` declared.
//
// For `"snappy"` it also checks and strips the four-byte big-endian
// CRC-32C that Avro's framing adds: `AvroChecksumMismatch` when it
// does not match, `AvroTruncated` when the payload is shorter than
// four bytes.
//
// ```novo
// use std.bytes
// use avrocodec
//
// fn main() [io]
//     match avrocodec.decompress(avrocodec.null_codec(), bytes.zeros(4), 0, 4, 1048576)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(e) => println(e.message())
// ```
pub fn decompress(c: AvroCodec, src: Bytes, at: Int, len: Int,
                  limit: Int) -> Result<Bytes, AvroFault> []
    let snappy = c.name == AVRO_CODEC_SNAPPY
    var body = len
    if snappy
        if len < AVRO_SNAPPY_TRAILER_BYTES
            return Err(avroerror.fault(AvroTruncated, avroerror.at_offset(-1, at)))
        body = len - AVRO_SNAPPY_TRAILER_BYTES
    let size = c.sized_by(src, at, body)
    if size < 0
        return Err(bad_parameter("the `${c.name}` payload declares no size"))
    if limit >= 0 and size > limit
        return Err(avroerror.fault(AvroLengthLimitReached(size, limit), avroerror.at_offset(-1, at)))
    let out = c.run(src, at, body)
    if bytes.len(out) != size
        return Err(bad_parameter("the `${c.name}` codec answered ${bytes.len(out)} bytes, not ${size}"))
    if snappy and crc32c(out, 0, size) != (bytes.u32_be_at(src, at + body) ?? 0)
        return Err(avroerror.fault(AvroChecksumMismatch(c.name), avroerror.at_offset(-1, at)))
    Ok(out)

// Compress a block's payload with a codec.
//
// `AvroBadParameter` for a codec whose `can_write` is false.  For
// `"snappy"` it appends the four-byte big-endian CRC-32C of the
// uncompressed data.
//
// ```novo
// use std.bytes
// use avrocodec
//
// fn main() [io]
//     match avrocodec.compress(avrocodec.null_codec(), bytes.zeros(4), 0, 4)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(e) => println(e.message())
// ```
pub fn compress(c: AvroCodec, src: Bytes, at: Int, len: Int) -> Result<Bytes, AvroFault> []
    if not c.writable
        return Err(bad_parameter("the `${c.name}` codec was supplied for reading only"))
    let out = c.pack(src, at, len)
    if c.name == AVRO_CODEC_SNAPPY
        return Ok(out + bytes.u32_be(crc32c(src, at, len)))
    Ok(out)
