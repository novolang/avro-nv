// avrofp.nv — schema fingerprints, and the single-object encoding they
// make possible.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// A FINGERPRINT IS A HASH OF THE PARSING CANONICAL FORM, and it is how
// a stream of Avro records says which schema each one was written with
// without repeating the schema.  A container file puts the schema in
// its header once and is done; a message queue, where each record is
// its own message, cannot — so the specification defines a
// SINGLE-OBJECT ENCODING: two marker bytes `C3 01`, an eight-byte
// fingerprint, and then the record's ordinary binary encoding.
//
// THE DEFAULT FINGERPRINT IS CRC-64-AVRO, and it is NOT a standard
// CRC-64.  The specification defines it as a 64-bit Rabin fingerprint
// with the polynomial constant `0xC15D213AA4D7A795`, initialised to
// `0xC15D213AA4D7A795` and folded eight bits at a time — different
// initialisation, different table, different answer from
// CRC-64/ECMA-182 and from CRC-64/XZ.  A port that reached for a CRC-64
// it already had would produce fingerprints no other Avro reader
// recognises, and the two check values below are what settle it.
//
// MD5 AND SHA-256 ARE ALSO DEFINED, for a caller that wants a wider
// one.  Both are over the same canonical form.  Only CRC-64-AVRO fits
// the single-object encoding's eight bytes.
//
// AND THE FINGERPRINT FUNCTIONS ARE VALUES TOO, for the same reason
// the codecs are: MD5 and SHA-256 belong to crypto-nv, and a caller
// that only ever uses CRC-64-AVRO — which is every caller doing
// single-object encoding — should not resolve a hash package to get
// it.  `rabin` is built in; `md5_of` and `sha256_of` take the digest
// function.

use avroerror
use avroschema

// The two bytes a single-object encoding starts with: `0xC3`, `0x01`.
//
// `0xC3` is not a legal first byte of any Avro datum whose schema is a
// primitive, which is what makes the marker recognisable.
pub const AVRO_SINGLE_OBJECT_MARKER_BYTES = 2

// How many bytes a single-object encoding's fingerprint occupies: 8.
pub const AVRO_FINGERPRINT_BYTES = 8

// The whole single-object prefix: 10 bytes.
pub const AVRO_SINGLE_OBJECT_PREFIX_BYTES = 10

// The CRC-64-AVRO polynomial constant: `0xC15D213AA4D7A795`.
//
// Used both as the polynomial and as the INITIAL value, which is the
// part that makes this not any standard CRC-64.
pub const AVRO_RABIN_CONSTANT = 0xC15D213AA4D7A795

// The fingerprint of the canonical form `"\"null\""`:
// `0x63DD24E7CC258F8A`.
//
// The specification's own worked example, and the one number that
// settles whether an implementation is CRC-64-AVRO or some other
// CRC-64.
pub const AVRO_RABIN_CHECK_NULL = 0x63DD24E7CC258F8A

// The fingerprint of the canonical form `"\"string\""`:
// `0x8F014872634503C7`.
//
// The specification's second worked example.
pub const AVRO_RABIN_CHECK_STRING = 0x8F014872634503C7

// The CRC-64-AVRO Rabin fingerprint of a canonical form.
//
// Takes the TEXT and not a schema, so a caller that already has a
// canonical form — from a schema registry, from a file's metadata —
// does not re-parse a schema to hash it.
//
// ```novo
// use avrofp
//
// fn main() [io]
//     let fp = avrofp.rabin("\"null\"")
//     println("${fp}")
// ```
pub fn rabin(canonical: Str) -> Int []
    todo("avro-nv.avrofp.rabin")

// The CRC-64-AVRO fingerprint of a schema: `rabin` of its canonical
// form.
//
// ```novo
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${avrofp.fingerprint(s)}")
//         Err(e) => println(e.message())
// ```
pub fn fingerprint(s: AvroSchema) -> Int []
    todo("avro-nv.avrofp.fingerprint")

// One entry of the 256-entry Rabin table.
//
// Published one entry at a time, so a build can compute the two
// kilobytes into memory at start-up or bake them into read-only
// storage, and neither choice is forced by the signature.
//
// `AvroBadParameter` outside `0` ..= `255`.
//
// ```novo
// use avrofp
//
// fn main() [io]
//     match avrofp.rabin_table_entry(0)
//         Ok(v)  => println("${v}")
//         Err(e) => println(e.message())
// ```
pub fn rabin_table_entry(i: Int) -> Result<Int, AvroFault> []
    todo("avro-nv.avrofp.rabin_table_entry")

// A fingerprint's eight bytes, LITTLE-endian, as a single-object
// encoding carries them.
//
// Little-endian, which is the opposite of what a reader who assumed
// network order would write, and the mistake that makes a producer's
// messages unreadable by every consumer.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     println("${bytes.len(avrofp.fingerprint_bytes(0))}")
// ```
pub fn fingerprint_bytes(fp: Int) -> Bytes []
    todo("avro-nv.avrofp.fingerprint_bytes")

// A fingerprint from the eight bytes at `off`.
//
// `AvroBufferTooSmall` for fewer than eight bytes from there.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.fingerprint_from(bytes.zeros(8), 0)
//         Ok(fp) => println("${fp}")
//         Err(e) => println(e.message())
// ```
pub fn fingerprint_from(src: Bytes, off: Int) -> Result<Int, AvroFault> []
    todo("avro-nv.avrofp.fingerprint_from")

// A wider fingerprint, through a digest function the caller supplies.
//
// The specification defines MD5 and SHA-256 fingerprints over the same
// canonical form.  Both belong to crypto-nv, and a caller that only
// ever uses CRC-64-AVRO — which is every caller doing single-object
// encoding — should not resolve a hash package to get it.  So the
// digest arrives as a NAMED FUNCTION, the same shape the codecs take.
//
// ```novo
// use std.bytes
// use avrofp
// use avroschema
//
// fn digest(data: Bytes) -> Bytes
//     bytes.zeros(32)
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${bytes.len(avrofp.wide_fingerprint(s, digest))}")
//         Err(e) => println(e.message())
// ```
pub fn wide_fingerprint(s: AvroSchema, digest: fn(Bytes) -> Bytes) -> Bytes []
    todo("avro-nv.avrofp.wide_fingerprint")

// The ten-byte prefix a single-object encoding starts with.
//
// `C3 01` and then the fingerprint, little-endian.
//
// ```novo
// use std.bytes
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${bytes.len(avrofp.single_object_prefix(s))}")
//         Err(e) => println(e.message())
// ```
pub fn single_object_prefix(s: AvroSchema) -> Bytes []
    todo("avro-nv.avrofp.single_object_prefix")

// Whether `src` at `off` begins a single-object encoding.
//
// The two marker bytes, and nothing else.  The cheap check a consumer
// makes before it looks up a fingerprint.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     println("${avrofp.is_single_object(bytes.zeros(10), 0)}")
// ```
pub fn is_single_object(src: Bytes, off: Int) -> Bool []
    todo("avro-nv.avrofp.is_single_object")

// The fingerprint a single-object encoding names, and where its datum
// starts.
//
// `AvroBadSingleObjectMarker` when the two marker bytes are wrong.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.read_single_object_prefix(bytes.zeros(10), 0)
//         Ok(p)  => println("${p.datum_at}")
//         Err(e) => println(e.message())
// ```
pub struct AvroSingleObject
    // The fingerprint of the schema the datum was written with.
    fingerprint: Int
    // The byte offset the datum's own encoding starts at.
    datum_at: Int

// Read a single-object encoding's prefix.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.read_single_object_prefix(bytes.zeros(10), 0)
//         Ok(p)  => println("${p.fingerprint}")
//         Err(e) => println(e.message())
// ```
pub fn read_single_object_prefix(src: Bytes, off: Int) -> Result<AvroSingleObject, AvroFault> []
    todo("avro-nv.avrofp.read_single_object_prefix")

// The schema among those offered whose fingerprint matches, or a
// fault naming the one that was asked for.
//
// `AvroUnknownFingerprint` carrying the fingerprint in hexadecimal —
// which `avroerror.is_unsupported` answers true for, because the
// message is fine and the CALLER is missing a schema.  That is the
// signal a consumer turns into "fetch this schema from the registry
// and retry", and it is the whole operational loop single-object
// encoding exists to support.
//
// ```novo
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avrofp.schema_for(0, [])
//         Ok(s)  => println(avroschema.type_name(s.kind))
//         Err(e) => println(e.message())
// ```
pub fn schema_for(fp: Int, known: [AvroSchema]) -> Result<AvroSchema, AvroFault> []
    todo("avro-nv.avrofp.schema_for")
