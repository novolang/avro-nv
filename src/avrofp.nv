// avrofp.nv — schema fingerprints, and the single-object encoding they
// make possible.
//
// A fingerprint is a hash of a schema's Parsing Canonical Form, and it
// is how a stream of records says which schema each was written with
// without repeating the schema (specification section "Schema
// Fingerprints").  A container file puts the schema in its header once.
// A message queue, where each record is its own message, cannot, so
// the specification defines a single-object encoding: the two marker
// bytes `C3 01`, the eight-byte fingerprint, and then the record's
// ordinary binary encoding.
//
// The default fingerprint is CRC-64-AVRO, which is not a standard
// CRC-64.  It is a 64-bit Rabin fingerprint whose polynomial and
// initial value are both `0xC15D213AA4D7A795`, folded eight bits at a
// time.  CRC-64/ECMA-182 and CRC-64/XZ give different answers, and the
// specification's two check values below settle which one a port
// computed.
//
// MD5 and SHA-256 fingerprints are defined over the same canonical
// form.  They belong to crypto-nv, so `wide_fingerprint` takes the
// digest as a named function, the same shape the codecs take.  Only
// CRC-64-AVRO fits the single-object encoding's eight bytes.

use std.bytes
use avroerror
use avroschema

// The bytes of a single-object encoding's marker, `0xC3` then `0x01`:
// 2.
pub const AVRO_SINGLE_OBJECT_MARKER_BYTES = 2

// How many bytes a single-object encoding's fingerprint occupies: 8.
pub const AVRO_FINGERPRINT_BYTES = 8

// The whole single-object prefix: 10 bytes.
pub const AVRO_SINGLE_OBJECT_PREFIX_BYTES = 10

// The CRC-64-AVRO polynomial constant: `0xC15D213AA4D7A795`.
//
// It is both the polynomial and the initial value.
pub const AVRO_RABIN_CONSTANT = 0xC15D213AA4D7A795

// The fingerprint of the canonical form `"null"`: `0x63DD24E7CC258F8A`.
//
// The specification's own worked example.
pub const AVRO_RABIN_CHECK_NULL = 0x63DD24E7CC258F8A

// The fingerprint of the canonical form `"string"`:
// `0x8F014872634503C7`.
//
// The specification's second worked example.
pub const AVRO_RABIN_CHECK_STRING = 0x8F014872634503C7

// Entry `i` of the Rabin table, for `i` from 0 to 255.
fn table_entry(i: Int) -> Int
    var fp = i
    for _ in 0..8
        fp = bits.shr(fp, 1) ^ (AVRO_RABIN_CONSTANT & (0 - (fp & 1)))
    fp

// The CRC-64-AVRO Rabin fingerprint of a canonical form.
//
// It takes the text and not a schema, so a caller that already has a
// canonical form, from a registry or a file's metadata, does not parse
// a schema to hash it.  The text is hashed as its UTF-8 bytes.
//
// ```novo
// use avrofp
//
// fn main() [io]
//     let fp = avrofp.rabin("\"null\"")
//     println("${fp}")
// ```
pub fn rabin(canonical: Str) -> Int []
    var fp = AVRO_RABIN_CONSTANT
    for i in 0..str.len(canonical)
        fp = bits.shr(fp, 8) ^ table_entry((fp ^ str.byte_at_or(canonical, i, 0)) & 0xFF)
    fp

// The CRC-64-AVRO fingerprint of a schema: `rabin` of its canonical
// form.
//
// ```novo
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${avrofp.fingerprint(s)}")
//         Err(e) => println(e.message())
// ```
pub fn fingerprint(s: AvroSchema) -> Int []
    rabin(avroschema.canonical_form(s))

// One entry of the 256-entry Rabin table.
//
// It is published one entry at a time, so a build can compute the
// table at start-up or place it in read-only storage.
// `AvroBadParameter` outside 0 to 255.
//
// ```novo
// use avrofp
//
// fn main() [io]
//     match avrofp.rabin_table_entry(0)
//         Ok(v)  => println("${v}")
//         Err(e) => println(e.message())
// ```
pub fn rabin_table_entry(i: Int) -> Result<Int, AvroFault> []
    if i < 0 or i > 255
        return Err(avroerror.fault(AvroBadParameter("a Rabin table index is from 0 to 255"),
                                   avroerror.at_path("")))
    Ok(table_entry(i))

// A fingerprint's eight bytes, little-endian, as a single-object
// encoding carries them.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     println("${bytes.len(avrofp.fingerprint_bytes(0))}")
// ```
pub fn fingerprint_bytes(fp: Int) -> Bytes []
    bytes.u64_le(fp)

// A fingerprint from the eight little-endian bytes at `off`.
//
// `AvroBufferTooSmall` for fewer than eight bytes from there.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.fingerprint_from(bytes.zeros(8), 0)
//         Ok(fp) => println("${fp}")
//         Err(e) => println(e.message())
// ```
pub fn fingerprint_from(src: Bytes, off: Int) -> Result<Int, AvroFault> []
    let have = bytes.len(src) - off
    if off < 0 or have < AVRO_FINGERPRINT_BYTES
        return Err(avroerror.fault(AvroBufferTooSmall(AVRO_FINGERPRINT_BYTES, math.max(have, 0)),
                                   avroerror.at_offset(-1, off)))
    Ok(bytes.u64_le_at(src, off) ?? 0)

// A wider fingerprint, through a digest function the caller supplies.
//
// The specification defines MD5 and SHA-256 fingerprints over the same
// canonical form.  The digest is handed the canonical form's UTF-8
// bytes.
//
// ```novo
// use std.bytes
// use avrofp
// use avroschema
//
// fn digest(data: Bytes) -> Bytes
//     bytes.zeros(32)
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${bytes.len(avrofp.wide_fingerprint(s, digest))}")
//         Err(e) => println(e.message())
// ```
pub fn wide_fingerprint(s: AvroSchema, digest: fn(Bytes) -> Bytes) -> Bytes []
    digest(bytes.from_str(avroschema.canonical_form(s)))

// The ten-byte prefix a single-object encoding starts with: `C3 01`
// and then the fingerprint, little-endian.
//
// ```novo
// use std.bytes
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"null\"")
//         Ok(s)  => println("${bytes.len(avrofp.single_object_prefix(s))}")
//         Err(e) => println(e.message())
// ```
pub fn single_object_prefix(s: AvroSchema) -> Bytes []
    bytes.from_byte_list([0xC3, 0x01]) + fingerprint_bytes(fingerprint(s))

// Whether `src` at `off` begins with the two marker bytes of a
// single-object encoding.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     println("${avrofp.is_single_object(bytes.zeros(10), 0)}")
// ```
pub fn is_single_object(src: Bytes, off: Int) -> Bool []
    (bytes.byte_at(src, off) ?? -1) == 0xC3 and (bytes.byte_at(src, off + 1) ?? -1) == 0x01

// The fingerprint a single-object encoding names, and where its datum
// starts.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.read_single_object_prefix(bytes.zeros(10), 0)
//         Ok(p)  => println("${p.datum_at}")
//         Err(e) => println(e.message())
// ```
pub struct AvroSingleObject
    // The fingerprint of the schema the datum was written with.
    fingerprint: Int
    // The byte offset the datum's own encoding starts at.
    datum_at: Int

// Read a single-object encoding's prefix.
//
// `AvroBadSingleObjectMarker` when the two marker bytes are wrong, and
// `AvroTruncated` when the input ends inside the prefix.
//
// ```novo
// use std.bytes
// use avrofp
//
// fn main() [io]
//     match avrofp.read_single_object_prefix(bytes.zeros(10), 0)
//         Ok(p)  => println("${p.fingerprint}")
//         Err(e) => println(e.message())
// ```
pub fn read_single_object_prefix(src: Bytes, off: Int) -> Result<AvroSingleObject, AvroFault> []
    let at = avroerror.at_offset(-1, off)
    if bytes.len(src) - off < AVRO_SINGLE_OBJECT_MARKER_BYTES
        return Err(avroerror.fault(AvroTruncated, at))
    if not is_single_object(src, off)
        return Err(avroerror.fault(AvroBadSingleObjectMarker, at))
    match fingerprint_from(src, off + AVRO_SINGLE_OBJECT_MARKER_BYTES)
        Err(_) => Err(avroerror.fault(AvroTruncated, at))
        Ok(fp) => Ok(AvroSingleObject { fingerprint: fp, datum_at: off + AVRO_SINGLE_OBJECT_PREFIX_BYTES })

// The schema among those offered whose fingerprint matches, or a fault
// naming the one asked for.
//
// `AvroUnknownFingerprint` carries the fingerprint as sixteen
// hexadecimal digits, most significant first.
// `avroerror.is_unsupported` answers true for it: the message is fine,
// and the caller is missing a schema, which it can fetch and offer.
//
// ```novo
// use avrofp
// use avroschema
//
// fn main() [io]
//     match avrofp.schema_for(0, [])
//         Ok(s)  => println(avroschema.type_name(s.kind))
//         Err(e) => println(e.message())
// ```
pub fn schema_for(fp: Int, known: [AvroSchema]) -> Result<AvroSchema, AvroFault> []
    for s in known
        if fingerprint(s) == fp
            return Ok(s)
    Err(avroerror.fault(AvroUnknownFingerprint(bytes.to_hex(bytes.u64_be(fp))), avroerror.at_path("")))
