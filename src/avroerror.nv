// avroerror.nv — one fault type over a schema language, a binary
// encoding, a container file and a resolution check.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// A POSITION IS EITHER A PLACE IN A SCHEMA OR A PLACE IN A STREAM, and
// they are not the same kind of thing.  A schema fault happens at a
// named path — `com.example.User.address.zip` — which is what a person
// editing a `.avsc` needs.  A stream fault happens at a byte offset in
// a block, which is what a person looking at a damaged file needs.
// `AvroWhere` carries both and a fault fills in whichever it has.
//
// AVRO'S BINARY ENCODING HAS NO MARKERS IN IT AT ALL.  A record is its
// fields' encodings concatenated; there is no field tag, no length and
// no terminator.  So a decoder reading with the wrong schema does not
// fail — it produces WRONG VALUES, confidently, until it runs off the
// end of the block.  That is the single most important fact about this
// format, and it is why `avroresolve` exists as a separate typed check
// rather than as something the decoder does as it goes.
//
// FOUR QUESTIONS, NOT ONE.  `is_corrupt` says the bytes are damaged,
// `is_incomplete` says more bytes would help, `is_schema_error` says
// the schema itself is wrong or the two schemas do not resolve, and
// `is_unsupported` says the file is good and asks for a codec or a
// logical type this build does not have.  A caller reports the four
// differently: the third is a developer's problem and the fourth is a
// build's.

// Where a fault was found.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let w = avroerror.at_path("com.example.User.address.zip")
//     println(w.path)
// ```
pub struct AvroWhere
    // The dotted path into the schema — the record's full name and
    // then each field, array element or map value on the way down —
    // or `""` where the fault is not about a schema.
    path: Str
    // Which block of a container file, 0-based, or `-1`.
    block: Int
    // The byte offset within that block, or from the start of the
    // input for a bare binary encoding.  `-1` where there is none.
    offset: Int

// A position in a schema, by its dotted path.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.at_path("com.example.User").path)
// ```
pub fn at_path(path: Str) -> AvroWhere []
    todo("avro-nv.avroerror.at_path")

// A position in a stream, by block and byte offset.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.at_offset(3, 1024).block}")
// ```
pub fn at_offset(block: Int, offset: Int) -> AvroWhere []
    todo("avro-nv.avroerror.at_offset")

// A position with both, for a fault found decoding a known field of a
// known block.
//
// The one a decoder actually produces most of the time, and the one
// worth having: "the `zip` field of the third record in block 12" is
// something a person can go and look at.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.at_both("User.zip", 12, 480).path)
// ```
pub fn at_both(path: Str, block: Int, offset: Int) -> AvroWhere []
    todo("avro-nv.avroerror.at_both")

// Why an Avro schema, datum or file could not be read.
//
// Every variant is prefixed `Avro`, because a variant is constructed
// by NAME across a whole program.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let f = avroerror.fault(AvroBadFileMagic, avroerror.at_offset(-1, 0))
//     println(avroerror.kind_name(f.kind))
// ```
pub enum AvroFaultKind
    // The schema text was not well-formed JSON.
    AvroSchemaNotJson(detail: Str)
    // A schema named a type that is neither a primitive, a complex
    // type, nor a name defined earlier in the same schema.
    AvroUnknownType(name: Str)
    // A named type — record, enum or fixed — was defined twice with
    // the same full name.
    AvroDuplicateName(name: Str)
    // A name or namespace that is not a legal Avro name: it must start
    // with a letter or underscore and continue with letters, digits
    // and underscores.
    AvroBadName(name: Str)
    // A record field, enum symbol or fixed size that the schema left
    // out or gave the wrong shape.
    AvroBadSchemaShape(detail: Str)
    // A field default whose JSON does not fit the field's type.
    //
    // Checked when the schema is parsed rather than when the default
    // is used, because a default that does not fit is a bug in the
    // schema and the person who can fix it is reading the schema.
    AvroBadDefault(field: Str)
    // A logical type whose annotation does not fit its underlying
    // type — a `decimal` whose precision exceeds what its `fixed` can
    // hold, a `duration` on something that is not a 12-byte `fixed`.
    //
    // NOT a refusal to read the file.  The specification says an
    // unusable logical-type annotation is IGNORED and the underlying
    // type is used, so this is what `avrological.of` answers rather
    // than what a decoder raises.
    AvroBadLogicalType(name: Str)
    // A reader schema and a writer schema that do not resolve.
    // Carries the rule that failed, in the specification's own words.
    //
    // THE FAULT THIS PACKAGE EXISTS TO MAKE EARLY.  Avro's binary
    // encoding has no markers, so a mismatch that is not caught here
    // is not caught at all — it is silently wrong values.
    AvroNoResolution(detail: Str)
    // A reader field with no default that the writer's schema does not
    // have.  Its own arm because it is the resolution failure people
    // actually hit, and because the fix is always the same: give the
    // field a default.
    AvroMissingFieldNoDefault(field: Str)
    // A union branch index outside the union's range.
    AvroBadUnionIndex(index: Int, branches: Int)
    // An enum symbol index outside the enum's range, with no
    // `default` on the reader's enum to fall back to.
    AvroBadEnumIndex(index: Int, symbols: Int)
    // A variable-length integer that did not terminate, or one that
    // encoded more than 64 bits.
    AvroBadVarint
    // A negative length on a string, bytes or fixed value — which
    // zigzag makes representable and the format does not allow.
    AvroNegativeLength(got: Int)
    // A length or block count above the caller's limit.  Carries both
    // numbers.
    //
    // NOT corruption.  Avro encodes a string's length as a varint
    // before its bytes, so a damaged or hostile file can declare a
    // two-gigabyte string in five bytes; the bound is the only thing
    // between a caller and that allocation.
    AvroLengthLimitReached(wanted: Int, allowed: Int)
    // A container file whose first four bytes were not `Obj` and
    // version 1.
    AvroBadFileMagic
    // A container file whose metadata did not carry `avro.schema`,
    // which the specification requires.
    AvroNoSchemaInFile
    // A container file block whose trailing sync marker did not match
    // the file's.
    //
    // THE CHECK THAT MAKES A CONTAINER FILE SPLITTABLE.  The sync
    // marker is what lets a reader start in the middle of a large file
    // and find the next block boundary, and a marker that does not
    // match means the reader is not where it thought it was.
    AvroSyncMismatch(block: Int)
    // A container file that names a codec this build cannot run.
    // Carries the name.
    //
    // NOT corruption.  `avro.codec` is an open set in the
    // specification and implementations add to it, so a file from a
    // newer writer is not a broken file.  `is_unsupported` answers
    // true, and `avrocodec.codec_named` is how a caller supplies one.
    AvroUnsupportedCodec(name: Str)
    // A single-object encoding whose two-byte marker was not `C3 01`.
    AvroBadSingleObjectMarker
    // A single-object encoding whose fingerprint matches no schema the
    // caller offered.  Carries the fingerprint, in hexadecimal.
    AvroUnknownFingerprint(fingerprint: Str)
    // The input ended in the middle of a value or a block.
    //
    // NOT corruption: it is what a decoder answers when the caller has
    // not supplied the whole file yet.
    AvroTruncated
    // A caller-supplied buffer was too small.
    AvroBufferTooSmall(want: Int, have: Int)
    // A caller's parameter was outside the range the function
    // documents.
    AvroBadParameter(what: Str)
    // The stream supplied to `avrofile.read_all` failed.
    AvroSourceFailed

// A fault, with the position it was found at.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let f = avroerror.fault(AvroTruncated, avroerror.at_offset(0, 17))
//     println("${f.at.offset}")
// ```
pub struct AvroFault
    // Why.
    kind: AvroFaultKind
    // Where.
    at: AvroWhere

// How an `AvroFault` reads when a `Result` carrying one is reported.
impl Error for AvroFault
    // The one-line report: the reason, the schema path where there is
    // one, and the block and offset where there is one.
    fn message(self) -> Str
        todo("avro-nv.avroerror.AvroFault.message")

// A fault from a kind and a position.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.kind_name(
//         avroerror.fault(AvroBadVarint, avroerror.at_offset(0, 3)).kind))
// ```
pub fn fault(kind: AvroFaultKind, at: AvroWhere) -> AvroFault []
    todo("avro-nv.avroerror.fault")

// A short, stable name for a kind: `"unknown-type"`,
// `"no-resolution"`, `"sync-mismatch"`.
//
// Stable because it goes in logs and in test expectations.
// `describe` is the sentence.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.kind_name(AvroTruncated))
// ```
pub fn kind_name(k: AvroFaultKind) -> Str []
    todo("avro-nv.avroerror.kind_name")

// One English sentence saying what went wrong and where, with every
// string and number the variant carries in it.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.describe(
//         avroerror.fault(AvroUnknownType("Colour"), avroerror.at_path("User"))))
// ```
pub fn describe(f: AvroFault) -> Str []
    todo("avro-nv.avroerror.describe")

// Whether the BYTES are damaged.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_corrupt(AvroBadVarint)}")
// ```
pub fn is_corrupt(k: AvroFaultKind) -> Bool []
    todo("avro-nv.avroerror.is_corrupt")

// Whether more bytes could turn this into a success.
//
// True for `AvroTruncated` alone.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_incomplete(AvroTruncated)}")
// ```
pub fn is_incomplete(k: AvroFaultKind) -> Bool []
    todo("avro-nv.avroerror.is_incomplete")

// Whether the SCHEMA is wrong, or the two schemas do not resolve.
//
// True for every parse-time arm and for both resolution arms.  A
// developer's problem, not a file's and not a build's — which is why
// it is a separate question from the other three.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let yes = avroerror.is_schema_error(AvroUnknownType("Colour"))
//     println("${yes}")
// ```
pub fn is_schema_error(k: AvroFaultKind) -> Bool []
    todo("avro-nv.avroerror.is_schema_error")

// Whether the file is GOOD and asks for something this build does not
// have.
//
// True for `AvroUnsupportedCodec` and `AvroUnknownFingerprint`.  Both
// name something a caller can supply — a codec value, a schema — so
// the answer is "wire that up", not "that file is broken".
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let yes = avroerror.is_unsupported(AvroUnsupportedCodec("bzip2"))
//     println("${yes}")
// ```
pub fn is_unsupported(k: AvroFaultKind) -> Bool []
    todo("avro-nv.avroerror.is_unsupported")

// Whether the fault is a bound this program chose.
//
// True for `AvroLengthLimitReached` and `AvroBufferTooSmall`.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_limit(AvroBufferTooSmall(64, 8))}")
// ```
pub fn is_limit(k: AvroFaultKind) -> Bool []
    todo("avro-nv.avroerror.is_limit")
