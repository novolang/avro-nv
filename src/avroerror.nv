// avroerror.nv — one fault type over a schema language, a binary
// encoding, a container file and a resolution check.
//
// A position is either a place in a schema or a place in a stream.  A
// schema fault happens at a dotted path such as
// `com.example.User.address.zip`, which is what a person editing a
// `.avsc` file needs.  A stream fault happens at a byte offset in a
// block, which is what a person looking at a damaged file needs.
// `AvroWhere` carries both, and a fault fills in whichever it has.
//
// Avro's binary encoding has no markers in it.  A record is its
// fields' encodings concatenated, with no field tag, no length and no
// terminator.  A decoder reading with the wrong schema therefore does
// not fail: it produces wrong values until it runs off the end of the
// block.  That is why `avroresolve` is a separate check made before
// decoding, and why a resolution fault is its own kind.
//
// Four questions sort the kinds.  `is_corrupt` says the bytes are
// damaged, `is_incomplete` says more bytes would help,
// `is_schema_error` says the schema is wrong or the two schemas do not
// resolve, and `is_unsupported` says the file is good and asks for a
// codec or a schema the caller did not supply.  `is_limit` answers a
// fifth: whether a bound the caller chose was reached.

// Where a fault was found.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let w = avroerror.at_path("com.example.User.address.zip")
//     println(w.path)
// ```
pub struct AvroWhere
    // The dotted path into the schema: the record's full name and
    // then each field, array element or map value on the way down.
    // `""` where the fault is not about a schema.
    path: Str
    // Which block of a container file, counted from 0, or `-1`.
    block: Int
    // The byte offset within that block, or from the start of the
    // input for a bare binary encoding.  `-1` where there is none.
    offset: Int

// A position in a schema, by its dotted path.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.at_path("com.example.User").path)
// ```
pub fn at_path(path: Str) -> AvroWhere []
    AvroWhere { path: path, block: -1, offset: -1 }

// A position in a stream, by block and byte offset.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.at_offset(3, 1024).block}")
// ```
pub fn at_offset(block: Int, offset: Int) -> AvroWhere []
    AvroWhere { path: "", block: block, offset: offset }

// A position with both, for a fault found decoding a known field of a
// known block.
//
// It is the position a decoder produces most often: "the `zip` field
// in block 12, at byte 480" is something a person can go and look at.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.at_both("User.zip", 12, 480).path)
// ```
pub fn at_both(path: Str, block: Int, offset: Int) -> AvroWhere []
    AvroWhere { path: path, block: block, offset: offset }

// Why an Avro schema, datum or file could not be read.
//
// Every variant is prefixed `Avro`, because a variant is constructed
// by name across a whole program.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let f = avroerror.fault(AvroBadFileMagic, avroerror.at_offset(-1, 0))
//     println(avroerror.kind_name(f.kind))
// ```
pub enum AvroFaultKind
    // The schema text was not well-formed JSON.
    AvroSchemaNotJson(detail: Str)
    // A schema named a type that is neither a primitive, a complex
    // type, nor a name defined earlier in the same schema.
    AvroUnknownType(name: Str)
    // A named type (record, enum or fixed) was defined twice with the
    // same full name.
    AvroDuplicateName(name: Str)
    // A name or namespace that is not a legal Avro name.  A name
    // starts with a letter or an underscore and continues with
    // letters, digits and underscores.
    AvroBadName(name: Str)
    // A record field, enum symbol, fixed size or union branch that the
    // schema left out, repeated or gave the wrong shape.
    AvroBadSchemaShape(detail: Str)
    // A field default whose JSON does not fit the field's type.
    //
    // It is checked when the schema is parsed, because a default that
    // does not fit is a mistake in the schema.
    AvroBadDefault(field: Str)
    // A logical type whose annotation does not fit its underlying
    // type, such as a `decimal` whose precision is more than its
    // `fixed` can hold.
    //
    // A decoder never raises it.  The specification says an unusable
    // annotation is ignored and the underlying type is used, so only
    // `avrological.check` answers it.
    AvroBadLogicalType(name: Str)
    // A reader schema and a writer schema that do not resolve.  It
    // carries the rule that failed.
    AvroNoResolution(detail: Str)
    // A reader field with no default that the writer's schema does not
    // have.  The fix is always the same: give the field a default.
    AvroMissingFieldNoDefault(field: Str)
    // A union branch index outside the union's range.
    AvroBadUnionIndex(index: Int, branches: Int)
    // An enum symbol index outside the enum's range.
    AvroBadEnumIndex(index: Int, symbols: Int)
    // A variable-length integer that did not end within ten bytes, or
    // one that encoded more than 64 bits.
    AvroBadVarint
    // A negative length or count where the format allows none.
    AvroNegativeLength(got: Int)
    // A length, count or depth above the caller's limit.  It carries
    // both numbers.
    //
    // It does not mean the bytes are damaged.  A string's length is a
    // varint written before its bytes, so a damaged or hostile file
    // can declare two gigabytes in five bytes, and the limit is what
    // stands between a caller and that allocation.
    AvroLengthLimitReached(wanted: Int, allowed: Int)
    // A container file whose first four bytes were not `Obj` and
    // version 1.
    AvroBadFileMagic
    // A container file whose metadata did not carry `avro.schema`,
    // which the specification requires.
    AvroNoSchemaInFile
    // A container file block whose trailing sync marker did not match
    // the file's.  The reader is not at the block boundary it thought
    // it was at.
    AvroSyncMismatch(block: Int)
    // A container file that names a codec the caller did not supply.
    // It carries the name.
    //
    // The file is not damaged: `avro.codec` is an open set, and a file
    // from a newer writer may name a codec this caller has not wired
    // in.
    AvroUnsupportedCodec(name: Str)
    // A block whose checksum did not match its data, such as the
    // CRC-32C that Avro's `snappy` framing puts after a block.  It
    // carries the codec's name.
    AvroChecksumMismatch(codec: Str)
    // A single-object encoding whose two-byte marker was not `C3 01`.
    AvroBadSingleObjectMarker
    // A single-object encoding whose fingerprint matches no schema the
    // caller offered.  It carries the fingerprint in hexadecimal.
    AvroUnknownFingerprint(fingerprint: Str)
    // The input ended in the middle of a value or a block.
    //
    // It does not mean the bytes are damaged.  It is what a decoder
    // answers when the caller has not supplied the whole input yet.
    AvroTruncated
    // A caller-supplied buffer was too small.
    AvroBufferTooSmall(want: Int, have: Int)
    // A caller's parameter was outside the range the function
    // documents.
    AvroBadParameter(what: Str)
    // The source a caller supplied failed.  No function in this
    // release answers it.
    AvroSourceFailed

// A fault, with the position it was found at.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let f = avroerror.fault(AvroTruncated, avroerror.at_offset(0, 17))
//     println("${f.at.offset}")
// ```
pub struct AvroFault
    // Why.
    kind: AvroFaultKind
    // Where.
    at: AvroWhere

// How an `AvroFault` reads when a `Result` carrying one is reported.
impl Error for AvroFault
    // The one-line report: `describe`'s sentence.
    fn message(self) -> Str
        describe(self)

// A fault from a kind and a position.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.kind_name(
//         avroerror.fault(AvroBadVarint, avroerror.at_offset(0, 3)).kind))
// ```
pub fn fault(kind: AvroFaultKind, at: AvroWhere) -> AvroFault []
    AvroFault { kind: kind, at: at }

// A short, stable name for a kind: `"unknown-type"`,
// `"no-resolution"`, `"sync-mismatch"`.
//
// The names are stable across releases, so a log or a test may match
// on them.  `describe` is the sentence.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.kind_name(AvroTruncated))
// ```
pub fn kind_name(k: AvroFaultKind) -> Str []
    match k
        AvroSchemaNotJson(_)         => "schema-not-json"
        AvroUnknownType(_)           => "unknown-type"
        AvroDuplicateName(_)         => "duplicate-name"
        AvroBadName(_)               => "bad-name"
        AvroBadSchemaShape(_)        => "bad-schema-shape"
        AvroBadDefault(_)            => "bad-default"
        AvroBadLogicalType(_)        => "bad-logical-type"
        AvroNoResolution(_)          => "no-resolution"
        AvroMissingFieldNoDefault(_) => "missing-field-no-default"
        AvroBadUnionIndex(_, _)      => "bad-union-index"
        AvroBadEnumIndex(_, _)       => "bad-enum-index"
        AvroBadVarint                => "bad-varint"
        AvroNegativeLength(_)        => "negative-length"
        AvroLengthLimitReached(_, _) => "length-limit-reached"
        AvroBadFileMagic             => "bad-file-magic"
        AvroNoSchemaInFile           => "no-schema-in-file"
        AvroSyncMismatch(_)          => "sync-mismatch"
        AvroUnsupportedCodec(_)      => "unsupported-codec"
        AvroChecksumMismatch(_)      => "checksum-mismatch"
        AvroBadSingleObjectMarker    => "bad-single-object-marker"
        AvroUnknownFingerprint(_)    => "unknown-fingerprint"
        AvroTruncated                => "truncated"
        AvroBufferTooSmall(_, _)     => "buffer-too-small"
        AvroBadParameter(_)          => "bad-parameter"
        AvroSourceFailed             => "source-failed"

// What a kind says, as the first half of `describe`'s sentence.
fn reason(k: AvroFaultKind) -> Str
    match k
        AvroSchemaNotJson(d)         => "the schema is not JSON: ${d}"
        AvroUnknownType(n)           => "`${n}` is not a type this schema defines"
        AvroDuplicateName(n)         => "`${n}` is defined twice"
        AvroBadName(n)               => "`${n}` is not a legal Avro name"
        AvroBadSchemaShape(d)        => "the schema is malformed: ${d}"
        AvroBadDefault(f)            => "the default of field `${f}` does not fit its type"
        AvroBadLogicalType(n)        => "the logical type `${n}` does not fit its underlying type and is ignored"
        AvroNoResolution(d)          => "the schemas do not resolve: ${d}"
        AvroMissingFieldNoDefault(f) => "the reader's field `${f}` is not in the writer's schema and has no default"
        AvroBadUnionIndex(i, n)      => "union branch ${i} is outside a union of ${n} branches"
        AvroBadEnumIndex(i, n)       => "enum symbol ${i} is outside an enum of ${n} symbols"
        AvroBadVarint                => "a variable-length integer is longer than 64 bits"
        AvroNegativeLength(n)        => "a length of ${n} is negative"
        AvroLengthLimitReached(w, a) => "${w} is above the limit of ${a}"
        AvroBadFileMagic             => "the input does not start with `Obj` and version 1"
        AvroNoSchemaInFile           => "the file's metadata has no `avro.schema`"
        AvroSyncMismatch(b)          => "block ${b} does not end with the file's sync marker"
        AvroUnsupportedCodec(n)      => "the codec `${n}` was not supplied"
        AvroChecksumMismatch(n)      => "a `${n}` block does not match its checksum"
        AvroBadSingleObjectMarker    => "the input does not start with the single-object marker C3 01"
        AvroUnknownFingerprint(fp)   => "no schema offered has the fingerprint ${fp}"
        AvroTruncated                => "the input ends in the middle of a value"
        AvroBufferTooSmall(w, h)     => "the buffer holds ${h} bytes and ${w} are needed"
        AvroBadParameter(what)       => "a parameter is out of range: ${what}"
        AvroSourceFailed             => "the source failed"

// One sentence saying what went wrong and where, with every string and
// number the variant carries in it.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println(avroerror.describe(
//         avroerror.fault(AvroUnknownType("Colour"), avroerror.at_path("User"))))
// ```
pub fn describe(f: AvroFault) -> Str []
    var out = reason(f.kind)
    if f.at.path != ""
        out = out + ", at `${f.at.path}`"
    if f.at.block >= 0
        out = out + ", in block ${f.at.block}"
    if f.at.offset >= 0
        out = out + ", at byte ${f.at.offset}"
    out

// Whether the bytes are damaged.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_corrupt(AvroBadVarint)}")
// ```
pub fn is_corrupt(k: AvroFaultKind) -> Bool []
    match k
        AvroBadUnionIndex(_, _)   => true
        AvroBadEnumIndex(_, _)    => true
        AvroBadVarint             => true
        AvroNegativeLength(_)     => true
        AvroBadFileMagic          => true
        AvroNoSchemaInFile        => true
        AvroSyncMismatch(_)       => true
        AvroChecksumMismatch(_)   => true
        AvroBadSingleObjectMarker => true
        _                         => false

// Whether more bytes could turn this into a success.
//
// True for `AvroTruncated` alone.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_incomplete(AvroTruncated)}")
// ```
pub fn is_incomplete(k: AvroFaultKind) -> Bool []
    match k
        AvroTruncated => true
        _             => false

// Whether the schema is wrong, or the two schemas do not resolve.
//
// True for every fault `avroschema.parse` answers, for the two
// resolution faults and for `AvroBadLogicalType`.  It is a
// developer's problem, not a file's and not a build's.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let yes = avroerror.is_schema_error(AvroUnknownType("Colour"))
//     println("${yes}")
// ```
pub fn is_schema_error(k: AvroFaultKind) -> Bool []
    match k
        AvroSchemaNotJson(_)         => true
        AvroUnknownType(_)           => true
        AvroDuplicateName(_)         => true
        AvroBadName(_)               => true
        AvroBadSchemaShape(_)        => true
        AvroBadDefault(_)            => true
        AvroBadLogicalType(_)        => true
        AvroNoResolution(_)          => true
        AvroMissingFieldNoDefault(_) => true
        _                            => false

// Whether the file is good and asks for something the caller did not
// supply.
//
// True for `AvroUnsupportedCodec` and `AvroUnknownFingerprint`.  Both
// name something a caller can supply, a codec value or a schema.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     let yes = avroerror.is_unsupported(AvroUnsupportedCodec("bzip2"))
//     println("${yes}")
// ```
pub fn is_unsupported(k: AvroFaultKind) -> Bool []
    match k
        AvroUnsupportedCodec(_)   => true
        AvroUnknownFingerprint(_) => true
        _                         => false

// Whether the fault is a bound this program chose.
//
// True for `AvroLengthLimitReached` and `AvroBufferTooSmall`.
//
// ```novo
// use avroerror
//
// fn main() [io]
//     println("${avroerror.is_limit(AvroBufferTooSmall(64, 8))}")
// ```
pub fn is_limit(k: AvroFaultKind) -> Bool []
    match k
        AvroLengthLimitReached(_, _) => true
        AvroBufferTooSmall(_, _)     => true
        _                            => false
