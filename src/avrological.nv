// avrological.nv — logical types: an annotation on an ordinary type
// that says what the bytes mean, and which a reader may ignore.
//
// A logical type does not change the encoding (specification section
// "Logical Types").  `{"type":"long","logicalType":"timestamp-millis"}`
// is written and read as a `long`, and the annotation says the number
// is milliseconds since the Unix epoch.  A reader that does not know
// `timestamp-millis` still reads the field, as a `long`.
//
// The specification requires a reader to ignore an annotation that
// does not fit its underlying type, such as a `decimal` whose
// precision is more than its `fixed` can hold, and to use the
// underlying type.  So `of` may answer `AvroNotLogical`, and nothing in
// this module raises a fault at decode time.  `check` is the separate
// call that tells a schema author an annotation is being ignored.
//
// A decimal is a two's complement big-endian integer, and its `scale`
// says where the point goes: the value is `unscaled / 10^scale`.  On a
// `fixed` the byte count is the fixed's size; on `bytes` it is
// whatever the writer wrote.
//
// A duration is a 12-byte `fixed` holding three unsigned 32-bit
// little-endian counts: months, days and milliseconds.  It is the only
// little-endian logical type in the specification.

use std.bytes
use avroerror
use avroschema

// Which logical type an annotation names.
//
// ```novo
// use avrological
//
// fn main() [io]
//     println(avrological.logical_name(AvroDate))
// ```
pub enum AvroLogical
    // No annotation, or one this package does not know or cannot use.
    // The ordinary answer, and not an error.
    AvroNotLogical
    // `decimal` on `bytes` or `fixed`: a two's complement big-endian
    // unscaled integer, divided by `10^scale`.
    AvroDecimal
    // `uuid` on `string`, or on a 16-byte `fixed`.
    AvroUuid
    // `date` on `int`: days since 1970-01-01.
    AvroDate
    // `time-millis` on `int`: milliseconds after midnight.
    AvroTimeMillis
    // `time-micros` on `long`: microseconds after midnight.
    AvroTimeMicros
    // `timestamp-millis` on `long`: milliseconds since the Unix epoch,
    // UTC.
    AvroTimestampMillis
    // `timestamp-micros` on `long`: microseconds since the Unix epoch,
    // UTC.
    AvroTimestampMicros
    // `timestamp-nanos` on `long`: nanoseconds since the Unix epoch,
    // UTC.
    AvroTimestampNanos
    // `local-timestamp-millis` on `long`: milliseconds since
    // 1970-01-01T00:00:00 in an unspecified local time zone.
    //
    // It is not the same as `timestamp-millis`, and the bytes do not
    // show the difference: one is an instant and the other is a wall
    // clock reading with no zone.
    AvroLocalTimestampMillis
    // `local-timestamp-micros` on `long`.
    AvroLocalTimestampMicros
    // `local-timestamp-nanos` on `long`.
    AvroLocalTimestampNanos
    // `duration` on a 12-byte `fixed`: three unsigned 32-bit
    // little-endian counts, months, days and milliseconds.
    AvroDuration

// The specification's name for a logical type: `"decimal"`, `"uuid"`,
// `"timestamp-millis"`.  `""` for `AvroNotLogical`.
//
// ```novo
// use avrological
//
// fn main() [io]
//     println(avrological.logical_name(AvroTimestampMicros))
// ```
pub fn logical_name(l: AvroLogical) -> Str []
    match l
        AvroNotLogical           => ""
        AvroDecimal              => "decimal"
        AvroUuid                 => "uuid"
        AvroDate                 => "date"
        AvroTimeMillis           => "time-millis"
        AvroTimeMicros           => "time-micros"
        AvroTimestampMillis      => "timestamp-millis"
        AvroTimestampMicros      => "timestamp-micros"
        AvroTimestampNanos       => "timestamp-nanos"
        AvroLocalTimestampMillis => "local-timestamp-millis"
        AvroLocalTimestampMicros => "local-timestamp-micros"
        AvroLocalTimestampNanos  => "local-timestamp-nanos"
        AvroDuration             => "duration"

// Every logical type, in declaration order.
fn all() -> [AvroLogical]
    [AvroDecimal, AvroUuid, AvroDate, AvroTimeMillis, AvroTimeMicros, AvroTimestampMillis,
     AvroTimestampMicros, AvroTimestampNanos, AvroLocalTimestampMillis, AvroLocalTimestampMicros,
     AvroLocalTimestampNanos, AvroDuration]

// The logical type an annotation names, or `AvroNotLogical`.
fn named(name: Str) -> AvroLogical
    for l in all()
        if logical_name(l) == name
            return l
    AvroNotLogical

// The logical type a schema's annotation names, ignoring one that does
// not fit.
//
// `AvroNotLogical` for a schema with no annotation, for an annotation
// this package does not know, and for one that does not fit its
// underlying type.  The specification requires the last: an unusable
// annotation is ignored and the underlying type is used.
//
// It never fails.  `check` is the call that reports an annotation
// being ignored.
//
// ```novo
// use avrological
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("{\"type\":\"int\",\"logicalType\":\"date\"}")
//         Ok(s)  => println(avrological.logical_name(avrological.of(s)))
//         Err(e) => println(e.message())
// ```
pub fn of(s: AvroSchema) -> AvroLogical []
    let l = named(s.logical)
    if fits(l, s)
        return l
    AvroNotLogical

// The logical type of a schema, or a fault when its annotation is being
// ignored.
//
// Answers `AvroNotLogical` for a schema with no annotation.
// `AvroBadLogicalType` names an annotation this package does not know
// or one that does not fit its underlying type.
// `avroerror.is_schema_error` answers true for it.  A schema review
// makes this call; a decoder does not.
//
// ```novo
// use avrological
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("{\"type\":\"int\",\"logicalType\":\"date\"}")
//         Ok(s) =>
//             match avrological.check(s)
//                 Ok(_)  => println("the annotation fits")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn check(s: AvroSchema) -> Result<AvroLogical, AvroFault> []
    if s.logical == ""
        return Ok(AvroNotLogical)
    let l = of(s)
    match l
        AvroNotLogical => Err(avroerror.fault(AvroBadLogicalType(s.logical), avroerror.at_path(s.full_name)))
        _              => Ok(l)

// Which underlying type a logical type sits on.
//
// `AvroBytes` for `decimal`, whose other legal type is `fixed`;
// `AvroString` for `uuid`, whose other legal type is a 16-byte
// `fixed`; `AvroInt` for `date` and `time-millis`; `AvroFixed` for
// `duration`; `AvroLong` for the rest.  `fits` accepts the second
// type too.  `AvroNull` for `AvroNotLogical`.
//
// ```novo
// use avrological
// use avroschema
//
// fn main() [io]
//     println(avroschema.type_name(avrological.underlying(AvroDate)))
// ```
pub fn underlying(l: AvroLogical) -> AvroType []
    match l
        AvroNotLogical => AvroNull
        AvroDecimal    => AvroBytes
        AvroUuid       => AvroString
        AvroDate       => AvroInt
        AvroTimeMillis => AvroInt
        AvroDuration   => AvroFixed
        _              => AvroLong

// Whether a type is a particular one.
fn same(a: AvroType, b: AvroType) -> Bool
    avroschema.type_name(a) == avroschema.type_name(b)

// Whether an annotation fits a schema.
//
// `decimal` fits `bytes` and `fixed`, with a precision of at least 1,
// a scale from 0 to the precision, and on a `fixed` a precision its
// bytes can hold.  `uuid` fits `string` and a 16-byte `fixed`.
// `duration` fits only a 12-byte `fixed`.  The rest fit exactly one
// primitive.  `AvroNotLogical` fits every schema.
//
// ```novo
// use avrological
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"int\"")
//         Ok(s)  => println("${avrological.fits(AvroDate, s)}")
//         Err(e) => println(e.message())
// ```
pub fn fits(l: AvroLogical, s: AvroSchema) -> Bool []
    match l
        AvroNotLogical => true
        AvroDecimal    =>
            if s.precision < 1 or s.scale < 0 or s.scale > s.precision
                return false
            if same(s.kind, AvroFixed)
                return fixed_bytes_for(s.precision) <= s.fixed_size
            same(s.kind, AvroBytes)
        AvroUuid       => same(s.kind, AvroString) or same(s.kind, AvroFixed) and s.fixed_size == 16
        AvroDuration   => same(s.kind, AvroFixed) and s.fixed_size == 12
        _              => same(s.kind, underlying(l))

// The fewest bytes a `fixed` needs to hold a decimal of `precision`
// digits.
//
// It is the smallest `n` for which a signed `n`-byte integer holds
// every number of `precision` digits, the specification's
// `ceil((precision * log2(10) + 1) / 8)`.  `AvroBadParameter` for a
// precision below 1.
//
// ```novo
// use avrological
//
// fn main() [io]
//     match avrological.decimal_fixed_bytes(18)
//         Ok(n)  => println("${n}")
//         Err(e) => println(e.message())
// ```
pub fn decimal_fixed_bytes(precision: Int) -> Result<Int, AvroFault> []
    if precision < 1
        return Err(avroerror.fault(AvroBadParameter("a decimal precision is 1 or more"),
                                   avroerror.at_path("")))
    Ok(fixed_bytes_for(precision))

// `decimal_fixed_bytes` for a precision of 1 or more.
fn fixed_bytes_for(precision: Int) -> Int
    let bits_needed = precision as Float * 3.321928094887362 + 1.0
    float.to_int(math.ceil(bits_needed / 8.0))

// The unscaled integer a decimal's bytes hold.
//
// The bytes are two's complement and big-endian, so the first bit is
// the sign.  `AvroLengthLimitReached` when they hold more than a
// 64-bit integer can.  Leading bytes that only extend the sign are
// accepted.
//
// ```novo
// use std.bytes
// use avrological
//
// fn main() [io]
//     match avrological.decimal_unscaled(bytes.zeros(4))
//         Ok(n)  => println("${n}")
//         Err(e) => println(e.message())
// ```
pub fn decimal_unscaled(data: Bytes) -> Result<Int, AvroFault> []
    let n = bytes.len(data)
    if n == 0
        return Ok(0)
    // -1 for a negative number and 0 for the rest: the sign bit,
    // extended across the whole integer.
    let sign = bits.asr((bytes.byte_at(data, 0) ?? 0) << 56, 63)
    let fill = sign & 0xFF
    var start = 0
    while n - start > 8 and (bytes.byte_at(data, start) ?? 0) == fill
        start += 1
    let top = bytes.byte_at(data, start) ?? 0
    if n - start > 8 or n - start == 8 and (top >= 0x80) != (fill == 0xFF)
        return Err(avroerror.fault(AvroLengthLimitReached(n, 8), avroerror.at_path("")))
    var v = sign
    for i in start..n
        v = (v << 8) | (bytes.byte_at(data, i) ?? 0)
    Ok(v)

// The bytes an unscaled integer encodes to, two's complement and
// big-endian, in the fewest bytes that hold it.  Zero is one byte.
//
// ```novo
// use std.bytes
// use avrological
//
// fn main() [io]
//     match avrological.decimal_bytes(-1234)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(e) => println(e.message())
// ```
pub fn decimal_bytes(unscaled: Int) -> Result<Bytes, AvroFault> []
    var n = 8
    while n > 1
        let rest = bits.asr(unscaled, 8 * (n - 1) - 1)
        if rest != 0 and rest != -1
            break
        n -= 1
    var out: [Int] = []
    for i in 0..n
        list.push(out, bits.shr(unscaled, 8 * (n - 1 - i)) & 0xFF)
    Ok(bytes.from_byte_list(out))

// A `duration`'s three counts.
//
// ```novo
// use std.bytes
// use avrological
//
// fn main() [io]
//     match avrological.duration_of(bytes.zeros(12))
//         Ok(d)  => println("${d.months}")
//         Err(e) => println(e.message())
// ```
pub struct AvroDurationValue
    // Whole months.
    months: Int
    // Whole days.
    days: Int
    // Milliseconds.
    millis: Int

// Read a `duration` from its twelve bytes.
//
// Three unsigned 32-bit little-endian counts.  `AvroBufferTooSmall`
// for fewer than twelve bytes.
//
// ```novo
// use std.bytes
// use avrological
//
// fn main() [io]
//     match avrological.duration_of(bytes.zeros(12))
//         Ok(d)  => println("${d.millis}")
//         Err(e) => println(e.message())
// ```
pub fn duration_of(data: Bytes) -> Result<AvroDurationValue, AvroFault> []
    if bytes.len(data) < 12
        return Err(avroerror.fault(AvroBufferTooSmall(12, bytes.len(data)), avroerror.at_offset(-1, 0)))
    Ok(AvroDurationValue { months: bytes.u32_le_at(data, 0) ?? 0, days: bytes.u32_le_at(data, 4) ?? 0,
                           millis: bytes.u32_le_at(data, 8) ?? 0 })

// The twelve bytes a duration encodes to.
//
// `AvroBadParameter` for a count below zero or above 4294967295, which
// an unsigned 32-bit field cannot hold.
//
// ```novo
// use std.bytes
// use avrological
//
// fn main() [io]
//     match avrological.duration_bytes(1, 2, 3)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(e) => println(e.message())
// ```
pub fn duration_bytes(months: Int, days: Int, millis: Int) -> Result<Bytes, AvroFault> []
    for n in [months, days, millis]
        if n < 0 or n > 4294967295
            return Err(avroerror.fault(AvroBadParameter("a duration count is from 0 to 4294967295"),
                                       avroerror.at_path("")))
    Ok(bytes.u32_le(months) + bytes.u32_le(days) + bytes.u32_le(millis))

// Whether a logical type is an instant in UTC rather than a wall clock
// reading with no zone.
//
// True for the three `timestamp-*` types and false for the three
// `local-timestamp-*` types, which are a `long` of the same magnitude.
//
// ```novo
// use avrological
//
// fn main() [io]
//     println("${avrological.is_instant(AvroTimestampMillis)}")
// ```
pub fn is_instant(l: AvroLogical) -> Bool []
    match l
        AvroTimestampMillis => true
        AvroTimestampMicros => true
        AvroTimestampNanos  => true
        _                   => false
