// ```
pub fn long_value(n: Int) -> AvroValue []
    todo("avro-nv.avrovalue.long_value")

// A `string` value.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     println(avrovalue.kind_name(avrovalue.str_value("hello")))
// ```
pub fn str_value(s: Str) -> AvroValue []
    todo("avro-nv.avrovalue.str_value")

// A union value: a branch index and the value on it.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     println(avrovalue.kind_name(
//         avrovalue.union_value(1, avrovalue.str_value("hello"))))
// ```
pub fn union_value(branch: Int, v: AvroValue) -> AvroValue []
    todo("avro-nv.avrovalue.union_value")

// The value inside a union, or `None` for a value that is not a union.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     match avrovalue.union_inner(avrovalue.union_value(0, AvroNullValue))
//         Some(v) => println(avrovalue.kind_name(v))
//         None    => println("not a union")
// ```
pub fn union_inner(v: AvroValue) -> ?AvroValue []
    todo("avro-nv.avrovalue.union_inner")

// The value of a record's field by name, given the record's schema.
//
// Records are encoded positionally and decoded into a positional list,
// so reading a field by name needs the schema.  Taking it here rather
// than storing names in every record value is what keeps a
// million-record decode from carrying a million copies of the same
// field names.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"int\"")
//         Ok(s) =>
//             match avrovalue.field_of(avrovalue.long_value(1), s, "id")
//                 Some(v) => println(avrovalue.kind_name(v))
//                 None    => println("no such field")
//         Err(e) => println(e.message())
// ```
pub fn field_of(v: AvroValue, s: AvroSchema, name: Str) -> ?AvroValue []
    todo("avro-nv.avrovalue.field_of")

// The value of a map's key, or `None`.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     match avrovalue.map_get(avrovalue.long_value(1), "k")
//         Some(v) => println(avrovalue.kind_name(v))
//         None    => println("not a map, or no such key")
// ```
pub fn map_get(v: AvroValue, key: Str) -> ?AvroValue []
    todo("avro-nv.avrovalue.map_get")

// Whether a value fits a schema, checked all the way down.
//
// `AvroBadSchemaShape`, which `avroerror.is_schema_error` answers
// true for, naming the path where it did not — a record
// with the wrong number of fields, an `int` value under a `string`
// schema, a union branch outside the union, an `enum` index outside
// the symbols, a `fixed` of the wrong length.
//
// THE CALL A WRITER MAKES BEFORE IT ENCODES.  Avro's encoding has no
// markers, so a value that did not fit its schema would be written as
// bytes nobody can read back and nothing would say so.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"long\"")
//         Ok(s) =>
//             match avrovalue.check(avrovalue.long_value(7), s)
//                 Ok(_)  => println("fits")
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn check(v: AvroValue, s: AvroSchema) -> Result<Int, AvroFault> []
    todo("avro-nv.avrovalue.check")

// The value a field default's JSON text denotes, under a schema.
//
// The specification's default encoding, which is NOT the same as the
// JSON encoding of Avro data: a `bytes` default is a string whose code
// points are the byte values, and a union's default is a value of its
// FIRST branch with no branch name around it.  Both are traps, and
// both live here rather than in a caller.
//
// `AvroBadDefault` when the JSON does not fit.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"long\"")
//         Ok(s) =>
//             match avrovalue.from_default_json("0", s)
//                 Ok(v)  => println(avrovalue.kind_name(v))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn from_default_json(json: Str, s: AvroSchema) -> Result<AvroValue, AvroFault> []
    todo("avro-nv.avrovalue.from_default_json")

// The value as Avro's JSON encoding, under a schema.
//
// Not the same as the default encoding above: here a union value is
// `{"<branch type name>": <value>}` except for `null`, which is bare
// `null`, and `bytes` is a string whose code points are the byte
// values.  The form `avro-tools tojson` writes.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"long\"")
//         Ok(s) =>
//             match avrovalue.to_json(avrovalue.long_value(7), s)
//                 Ok(j)  => println(j)
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn to_json(v: AvroValue, s: AvroSchema) -> Result<Str, AvroFault> []
    todo("avro-nv.avrovalue.to_json")

// A value from Avro's JSON encoding, under a schema.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"long\"")
//         Ok(s) =>
//             match avrovalue.from_json("7", s)
//                 Ok(v)  => println(avrovalue.kind_name(v))
//                 Err(e) => println(e.message())
//         Err(e) => println(e.message())
// ```
pub fn from_json(json: Str, s: AvroSchema) -> Result<AvroValue, AvroFault> []
    todo("avro-nv.avrovalue.from_json")

// Compare two values under a schema, in the specification's sort
// order.
//
// Answers a negative number, zero or a positive one.  The order is not
// the obvious one: a record compares field by field in the order the
// fields are DECLARED, skipping fields whose `order` is `"ignore"` and
// reversing those whose `order` is `"descending"`; an enum compares by
// symbol INDEX and not alphabetically; a union compares by branch
// index first.
//
// Published because Avro data is sorted by this order in every system
// that sorts it, and a caller that used its own would disagree with
// every other reader of the same file.
//
// ```novo
// use avrovalue
// use avroschema
//
// fn main() [io]
//     match avroschema.parse("\"long\"")
//         Ok(s) =>
//             println("${avrovalue.compare(avrovalue.long_value(1),
//                                          avrovalue.long_value(2), s)}")
//         Err(e) => println(e.message())
// ```
pub fn compare(a: AvroValue, b: AvroValue, s: AvroSchema) -> Int []
    todo("avro-nv.avrovalue.compare")
