// avrovalue.nv — the value an Avro datum decodes to, and the reason it
// is one type rather than a generic JSON value.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// WHY THIS PACKAGE DECLARES ITS OWN VALUE TYPE.  A decoded Avro datum
// is not JSON and does not fit a JSON value without losing things that
// matter: `bytes` and `string` are different types with the same
// encoding, `int` and `long` are different widths, `float` and `double`
// are different precisions, an `enum` is a symbol and not a string, a
// `fixed` is not a `bytes`, and a union value remembers WHICH BRANCH
// it came from.  A decoder that answered a JSON value would throw all
// six away, and a writer round-tripping through it would produce a
// different file.
//
// AND THE VALUE CARRIES ITS BRANCH.  `AvroUnionValue` holds the branch
// index beside the value, because a union of `["null","string"]` and a
// union of `["string","null"]` encode the same string differently, and
// a value that had forgotten which union it belonged to could not be
// written back.
//
// ONE ARM PER TYPE, AND NOT ONE MORE.  There is no `AvroAny` and no
// untyped escape: a value is always one of the fourteen, and the
// schema says which.  That is what lets `avrobinary.encode` be total —
// given a schema and a value of it, there is no case where it does not
// know what to write.

use avroerror
use avroschema

// A decoded Avro datum.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     println(avrovalue.kind_name(avrovalue.long_value(7)))
// ```
pub enum AvroValue
    // The one value of the `null` type.
    AvroNullValue
    // A boolean.
    AvroBoolValue(b: Bool)
    // A 32-bit signed integer.
    AvroIntValue(n: Int)
    // A 64-bit signed integer.  A separate arm from `AvroIntValue`
    // because the two have different encodings and because a schema
    // that says `int` may not be handed a value that does not fit one.
    AvroLongValue(n: Int)
    // A 32-bit float.
    AvroFloatValue(x: Float)
    // A 64-bit double.
    AvroDoubleValue(x: Float)
    // A length-prefixed byte sequence.
    AvroBytesValue(b: Bytes)
    // A length-prefixed byte sequence meant as UTF-8.  A separate arm
    // from `AvroBytesValue` although the encodings are identical,
    // because the schema distinguishes them and a round trip must.
    AvroStrValue(s: Str)
    // A record: one value per field, in the schema's field order.
    AvroRecordValue(fields: [AvroValue])
    // An enum: the symbol's INDEX, not its text.  The index is the
    // encoding, and resolution maps a writer's index to a reader's.
    AvroEnumValue(index: Int)
    // An array.
    AvroArrayValue(items: [AvroValue])
    // A map: keys and values in two parallel lists, in the order the
    // file carried them.
    //
    // Two lists rather than a pair list because Avro's map keys are
    // always strings and a caller looking one up wants the keys
    // without walking pairs.  The ORDER is kept because a round trip
    // must reproduce the file, and Avro does not say a map is sorted.
    AvroMapValue(keys: [Str], values: [AvroValue])
    // A union: which branch, and the value of that branch.
    //
    // THE ARM THAT CARRIES THE BRANCH.  A union of `["null","string"]`
    // and one of `["string","null"]` encode the same string
    // differently, so a value that forgot its branch could not be
    // written back.
    AvroUnionValue(branch: Int, value: [AvroValue])
    // A fixed-length byte sequence, with no length prefix on the wire.
    AvroFixedValue(b: Bytes)

// A short, stable name for a value's kind: `"long"`, `"record"`,
// `"union"`.
//
// ```novo
// use avrovalue
//
// fn main() [io]
//     println(avrovalue.kind_name(AvroNullValue))
// ```
pub fn kind_name(v: AvroValue) -> Str []
    todo("avro-nv.avrovalue.kind_name")

// A `long` value.
